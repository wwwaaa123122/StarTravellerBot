# ============================================================
# 星辰旅人 (StarTravellerBot) 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ============================================================

# QQ 开放平台凭证 (必填)
# 从 https://q.qq.com 开放平台获取
STAR_QO_APPID=your_appid_here
STAR_QO_SECRET=your_app_secret_here

# AI API 密钥 (至少配置一个)
STAR_DEEPSEEK_KEY=sk-your_deepseek_key_here
STAR_GEMINI_KEY=your_gemini_key_here
STAR_OPENAI_KEY=sk-your_openai_key_here

# AI 可选配置
# STAR_AI_BASE_URL=https://api.deepseek.com
# STAR_AI_MODEL=deepseek-v4-flash
# STAR_AI_MAX_TOKENS=2000
# STAR_AI_TEMPERATURE=0.7

# Web 管理后台密码 (必填，建议强密码)
STAR_TRAVELLER_ADMIN_PASSWORD=change_me_to_a_strong_password