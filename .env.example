# ============================================================
# 星辰旅人 (StarTravellerBot) 环境变量配置模板
# 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# 所有配置均可通过 .env 或环境变量设置，环境变量优先级更高
# ============================================================

# QQ 开放平台凭证 (必填)
# 从 https://q.qq.com 开放平台获取
STAR_QO_APPID=your_appid_here
STAR_QO_SECRET=your_app_secret_here

# 机器人基础信息
# STAR_BOT_NAME=星辰旅人
# STAR_BOT_NAME_EN=XCLR
# STAR_BOT_REMINDER=#
# STAR_BOT_ROOT_USER=openid1,openid2
# STAR_BOT_DEFAULT_MODE=Ds
# STAR_BOT_ALLOW_AI=true

# AI API 密钥 (至少配置一个)
STAR_DEEPSEEK_KEY=your_deepseek_key_here
STAR_GEMINI_KEY=your_gemini_key_here
STAR_OPENAI_KEY=your_openai_key_here

# AI 可选配置
# STAR_AI_BASE_URL=https://api.deepseek.com
# STAR_AI_MODEL=deepseek-v4-flash
# STAR_AI_MAX_TOKENS=2000
# STAR_AI_TEMPERATURE=0.7
# STAR_AI_PRICE_INPUT=1.0
# STAR_AI_PRICE_OUTPUT=2.0

# 日志级别与黑名单
# STAR_LOG_LEVEL=INFO
# STAR_BLACK_LIST=openid1,openid2

# Web 管理后台 (密码必填，建议强密码)
STAR_TRAVELLER_ADMIN_PASSWORD=change_me_to_a_strong_password
# STAR_TRAVELLER_ADMIN_ENABLED=true
# STAR_TRAVELLER_ADMIN_HOST=0.0.0.0
# STAR_TRAVELLER_ADMIN_PORT=8765

# 定时群发
# STAR_SCHEDULED_SEND_TIME=06:00
# STAR_SCHEDULED_SEND_CONTENT=早生蚝
# STAR_SCHEDULED_SEND_GROUPS=group_openid1,group_openid2
# STAR_SCHEDULED_SEND_ADMIN=admin_openid
# STAR_SCHEDULED_SEND_ENABLED=true
